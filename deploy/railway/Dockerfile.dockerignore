# BuildKit reads <Dockerfile>.dockerignore; the context is the repo root. Send only what the image needs.
*
!license-server/package.json
!license-server/package-lock.json
!license-server/tsconfig.json
!license-server/tsconfig.build.json
!license-server/src
!landing
# Not part of the public site: UI/UX dev scripts, review screenshots, dotfiles, notes.
landing/tools
landing/docs
landing/**/.*
landing/**/*.md
landing/**/node_modules
!deploy/railway/Caddyfile
!deploy/railway/entrypoint.sh

!license-server/package-lock.json
!license-server/tsconfig.json
!license-server/tsconfig.build.json
!license-server/src
!landing
landing/**/.*
landing/**/*.md
landing/**/node_modules
!deploy/railway/Caddyfile
!deploy/railway/entrypoint.sh

# AirBridge Headscale v0.29.7 config for the single-container Railway deployment (deploy/railway).
# Rendered by entrypoint.sh (__PUBLIC_DOMAIN__ = $RAILWAY_PUBLIC_DOMAIN). Derived from
# license-server/headscale/config.yaml.tmpl; differences are Railway-specific and commented.
---
server_url: https://__PUBLIC_DOMAIN__

# Loopback only: Caddy (same container) is the only client. Railway terminates TLS at its edge.
listen_addr: 127.0.0.1:8081
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443
grpc_allow_insecure: false

# Caddy on loopback forwards X-Forwarded-For.
trusted_proxies:
  - 127.0.0.1/32

noise:
  private_key_path: /data/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    # Embedded DERP relay over https://__PUBLIC_DOMAIN__/derp (443 at Railway's edge).
    # Railway has no public UDP, so STUN is bound to loopback (unreachable): peers on different networks
    # relay through this DERP instead of connecting directly. Accepted for the preview.
    enabled: true
    region_id: 999
    region_code: "airbridge"
    region_name: "AirBridge Relay"
    verify_clients: true
    stun_listen_addr: "127.0.0.1:3478"
    private_key_path: /data/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
    # No fixed IPs: Railway's edge is reached by DNS name.
    ipv4: ""
    ipv6: ""
  # No Tailscale-operated DERP servers.
  urls: []
  paths: []
  auto_update_enabled: false
  update_frequency: 24h

disable_check_updates: true

node:
  expiry: 0
  ephemeral:
    inactivity_timeout: 30m

database:
  type: sqlite
  debug: false
  gorm:
    prepare_stmt: true
    parameterized_queries: true
    skip_err_record_not_found: true
    slow_threshold: 1000
  sqlite:
    path: /data/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

tls_letsencrypt_hostname: ""
tls_cert_path: ""
tls_key_path: ""

log:
  level: info
  format: json

policy:
  mode: file
  path: /etc/headscale/policy.hujson

dns:
  magic_dns: false
  base_domain: ""
  override_local_dns: false
  nameservers:
    global: []
    split: {}
  search_domains: []
  extra_records: []

unix_socket: /run/headscale/headscale.sock
unix_socket_permission: "0700"

logtail:
  enabled: false

taildrop:
  enabled: false

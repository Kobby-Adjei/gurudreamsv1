# AirBridge license server — copy to .env (never commit real values).
PORT=8787
# Public HTTPS base URL of this deployment (Checkout success/cancel pages). Required when NODE_ENV=production.
PUBLIC_BASE_URL=https://license.example.com

# Stripe (Dashboard -> Developers). Use test-mode keys until launch.
# Secret key (test-mode key until launch; restricted keys also work).
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
STRIPE_PRICE_ID_PRO=REPLACE_ME

# Clerk (Dashboard -> Configure -> OAuth applications / API keys).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# The OAuth application's client ID (the desktop sends the OIDC id_token, whose aud is the client ID).
# Comma-separate to accept several audiences.
CLERK_AUDIENCE=REPLACE_ME_OAUTH_CLIENT_ID

# Ed25519 license signing key: run `npm run keys:generate`.
# PKCS8 PEM; literal "\n" sequences are accepted for single-line env stores.
LICENSE_SIGNING_KEY_PEM=REPLACE_ME_WITH_PKCS8_PEM_FROM_keys_generate
LICENSE_KEY_ID=ab-2026-01
LICENSE_TTL_SECONDS=259200

# Postgres connection string. Omit only for local dev (in-memory store; refused when NODE_ENV=production).
DATABASE_URL=postgres://user:password@localhost:5432/airbridge

# Set to 1 when running behind a trusted reverse proxy (Railway/Fly/Vercel) so rate limiting keys on X-Forwarded-For.
TRUST_PROXY=1
# Number of trusted proxies that append to X-Forwarded-For (the client IP is taken this many entries from the RIGHT).
TRUST_PROXY_HOPS=1

# Phase 3 private network: self-hosted Headscale v0.29.7 (see headscale/README.md).
# Leave all three unset in local dev to disable /v1/network/* (they answer 503).
# Admin REST API over a PRIVATE network only (the public site 404s /api/*). In the bundled compose stack:
# http://headscale:8080. Allowed: https, or http to localhost / a single-label internal service name.
HEADSCALE_URL=http://headscale:8080
# headscale apikeys create --expiration 90d   (rotate before expiry)
HEADSCALE_API_KEY=REPLACE_ME
# Public login server the desktop app enrolls with (Headscale server_url).
HEADSCALE_PUBLIC_URL=https://hs.example.com
# Single-use pre-auth key lifetime in seconds (60-3600).
PREAUTH_TTL_SECONDS=600

# Preview mode (PHASE3_PLAN.md §8): false = any signed-in user may get a network pre-auth key (no 402);
# logged as ENTITLEMENT_NOT_ENFORCED. Does not affect /v1/license/verify. Default true; set true at launch.
ENFORCE_ENTITLEMENT=false

# Landing-page waitlist (demand test). Append-only JSONL with sign-up emails: keep it on a persistent volume.
WAITLIST_PATH=/data/waitlist/waitlist.jsonl
# Bearer token for GET /v1/waitlist/stats and /v1/waitlist/export (openssl rand -hex 32). Unset -> both 404.
WAITLIST_ADMIN_TOKEN=REPLACE_ME

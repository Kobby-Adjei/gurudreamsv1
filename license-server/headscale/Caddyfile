# AirBridge Headscale front door (Caddy 2). Env: HEADSCALE_DOMAIN, ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

http://{$HEADSCALE_DOMAIN} {
	# Tailscale captive-portal detection
	handle /generate_204 {
		respond 204
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{$HEADSCALE_DOMAIN} {
	# Headscale API keys are full admin. The REST API and its docs are NEVER served on the public site:
	# the license server reaches Headscale over the internal compose network (http://headscale:8080).
	@admin path /api /api/* /swagger /swagger*
	respond @admin 404

	# Control protocol (TS2021 upgrade), embedded DERP (/derp), /key, /health, /generate_204.
	# Caddy proxies Upgrade/WebSocket connections natively.
	reverse_proxy headscale:8080 {
		header_up X-Real-IP {remote_host}
	}

	header -Server
	log {
		output stdout
		format json
	}
}

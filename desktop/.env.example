# AirBridge Pro desktop — copy to desktop/.env for `npm run dev` (never commit real values).
# All values below are PUBLIC configuration; no secrets belong in the desktop app.

# License server base URL (https; http allowed only for localhost in dev).
AIRBRIDGE_LICENSE_URL=https://license.example.com

# Clerk OAuth application (public client, PKCE). Redirect URI: airbridge://auth/callback
CLERK_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=REPLACE_ME_OAUTH_CLIENT_ID

# 1 = demo mode: fake signed-in user, valid license, fake nodes and live events.
# Honored only when the app is NOT packaged.
AIRBRIDGE_DEV_MOCKS=1

# Dev only: Python interpreter for the MCP config fallback when airbridge-core is not built.
# AIRBRIDGE_PYTHON=python3

# Dev only (ignored when packaged): JSON map kid -> SPKI PEM to trust instead of the compiled keys.
# AIRBRIDGE_LICENSE_PUBKEYS=
